# ── 필수 ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME   # Railway: ${{Postgres.DATABASE_URL}}
SECRET_KEY=                 # 48자 이상 무작위 문자열. 세션 서명 + 비밀 설정 암호화에 사용(변경 시 저장된 PG/SMTP 키를 다시 입력해야 함)
ADMIN_PASSWORD=             # 최고관리자(admin) 초기 비밀번호. 비워 두면 임시 비밀번호가 서버 로그에 1회 출력됨

# ── 선택 ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
PUBLIC_BASE_URL=            # 예: https://xxx.up.railway.app (이메일 링크·OAuth·웹훅 주소에 사용)
STORAGE_DIR=/data           # 영구 볼륨 마운트 경로(APK·스크린샷·보고서·백업)
ENCRYPTION_KEY=             # 비밀 설정 암호화 전용 키(미설정 시 SECRET_KEY에서 파생)
MAX_APK_MB=300
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
RATE_LIMIT_PER_MIN=1200
RUN_SCHEDULER=1             # 0이면 이 인스턴스에서 스케줄러를 돌리지 않음
AGENT_DOWNLOAD_REPO=sangjindl9-lab/do

# PG·SMTP·AI·Google OAuth 인증정보는 환경변수가 아니라 관리자 페이지에서 등록합니다(암호화 저장).
